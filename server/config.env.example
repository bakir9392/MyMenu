# ============================================================
# Copier ce fichier en "config.env" et remplir les valeurs
# Copy this file to "config.env" and fill in the values
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Public URL used in QR codes (leave empty = auto-detect local Wi-Fi IP)
PUBLIC_URL=

# Restaurant name shown on receipts
RESTAURANT_NAME=My Restaurant

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=menu_magique
DB_USER=menu_magique
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
MYSQL_ROOT_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD_HERE

# Allow new restaurant sign-ups (true/false)
ALLOW_SIGNUP=true

# JWT secret (leave empty = auto-generated and saved in .auth-secret)
# AUTH_SECRET=

# SMTP for "forgot password" emails (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=My Restaurant <your-email@gmail.com>

# WhatsApp number shown on login/signup page (digits only, with country code, no + or spaces)
# Example: 213699937826  for +213 699 937 826
WHATSAPP_NUMBER=
